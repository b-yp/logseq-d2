{
  "name": "logseq-d2",
  "version": "1.4.0",
  "description": "Render D2 diagrams in Logseq, fully client-side via WASM",
  "main": "index.html",
  "author": "b-yp",
  "license": "MIT",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=dist/index.js --format=iife --target=es2020 --define:global=globalThis --watch",
    "build": "esbuild src/main.ts --bundle --outfile=dist/index.js --format=iife --target=es2020 --define:global=globalThis",
    "typecheck": "tsc --noEmit",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@terrastruct/d2": "^0.1.33"
  },
  "devDependencies": {
    "@logseq/libs": "^0.0.17",
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/exec": "^6.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^10.0.4",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "esbuild": "^0.20.0",
    "semantic-release": "^20.1.0",
    "typescript": "^5.3.0"
  },
  "logseq": {
    "id": "b-yp-logseq-d2",
    "icon": "./logo.svg"
  }
}
